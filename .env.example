POSTGRES_DB=arogyakhosh
POSTGRES_USER=arogya
POSTGRES_PASSWORD=arogya
POSTGRES_PORT=5433

BACKEND_PORT=8080
GIN_MODE=release

JWT_SECRET=replace-me-with-32-plus-random-bytes-openssl-rand-hex-32
JWT_ISSUER=arogyakhosh

FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Object storage. Leave SUPABASE_URL blank to run without uploads.
# SUPABASE_SERVICE_KEY is the service_role key: it bypasses Supabase RLS,
# so it must never be exposed to the browser. The bucket must be private.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=records

AI_PORT=50051
AI_MAX_WORKERS=4

# Email. Leave SMTP_HOST blank to run without it: alerts are logged instead of
# sent, which is usually what you want locally.
#
# SMTP_FROM must be a valid address, optionally with a display name.
# SMTP_ALLOW_INSECURE=true skips the STARTTLS requirement and is only for a
# local catcher such as Mailpit. Never set it against a real provider - the
# password would cross the wire in the clear.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ArogyaKhosh <alerts@arogyakhosh.local>
SMTP_ALLOW_INSECURE=false
